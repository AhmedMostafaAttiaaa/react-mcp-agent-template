{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(agent/blocklist.txt)",
      "Read(data/**)",
      "Read(traces/**)",
      "Read(conversations/**)",
      "Read(**/*.jsonl)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(type .env*)",
      "Bash(cat data/*)",
      "Bash(cat traces/*)",
      "Bash(cat conversations/*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.docker/**)",
      "Read(~/.config/**)"
    ]
  }
}
